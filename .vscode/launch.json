{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "debug ts",
      "program": "${workspaceFolder}/src/index.ts",
      "preLaunchTask": "tsc: build - tsconfig.json",
      "outFiles": ["${workspaceFolder}/build/**/*.js"],
      "request": "launch",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "type": "node"
    },
    {
      "name": "Python: 当前文件",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "logToFile": true,
      "args":["-s","yes"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "debug server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run-script", "debug"]
    },
    {
      "name": "Attach to NPM",
      "type": "node",
      "request": "attach",
      "port": 9229
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Launch test script",
      "program": "${workspaceFolder}/src/test/js/wsServer.js"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Launch load test script",
      "program": "${workspaceFolder}/src/test/js/load.js",
      "args": ["-r", "60", "-c", "3"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "pubsub",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run-script", "pubsub"]
    }
  ]
}
