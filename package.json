{
  "name": "ws-pubsub",
  "version": "2.0.0",
  "description": "try socketio & redis pubsub",
  "repository": {
    "type": "git",
    "url": "ssh://git@git.emicloud.com:22221/webcc/ws_redis.git"
  },
  "main": "index.js",
  "//": [
    "1. different scripts for different use cases:",
    "2. prod use pm2 is our deployment case and github action also uses it",
    "3. tss is for docker image build step to verify the server can start, so it needs to exit",
    "4. pm2.5 is our docker entrypoint using pm2-runtime even though we don't really use this image",
    "5. debug is supposed for vscode debug but we havn't used for a while",
    "6. start uses nodemon for daily development, with ctrl+c to exit nodemon & redis together",
    "7. test is the client code to verify the server works, github action also uses it"
  ],
  "scripts": {
    "build": "npx tsc",
    "pub": "DEBUG=app:* node src/test/js/pubsub.js",
    "pubsub": "DEBUG=app:* node --nolazy --inspect-brk=9229 build/index.js",
    "basic": "DEBUG=app:* node src/test/js/json_test.js",
    "prestart": "redis-server &",
    "start": "DEBUG=app:* nodemon --ignore --nolazy src/index.ts",
    "predebug": "src/shell/redis_check.sh",
    "debug": "DEBUG=app:* node --nolazy build/index.js",
    "preprod": "src/shell/redis_check.sh",
    "prod": "pm2 start ecosystem.config.js --env production",
    "pm2log": "pm2 set pm2-logrotate:workerInterval 150",
    "prepm2.5": "redis-server /etc/redis.conf &",
    "pm2.5": "pm2-runtime ecosystem.config.js",
    "test": "DEBUG=test:* ts-node src/test/ts/socketTest.ts",
    "testwc": "DEBUG=wechat:* node src/test/wechat/token.js",
    "perf": "DEBUG=perf:* ts-node src/test/perf/task.ts"
  },
  "author": "qiulang",
  "license": "ISC",
  "dependencies": {
    "@socket.io/admin-ui": "^0.4.0",
    "axios": "^0.27.2",
    "cors": "^2.8.5",
    "debug": "^4.1.1",
    "dotenv-flow": "^3.1.0",
    "express": "^4.17.1",
    "ioredis": "^4.27.5",
    "locutus": "^2.0.14",
    "pm2": "^5.2.0",
    "portfinder": "^1.0.28",
    "socket.io": "^4.5.0",
    "socket.io-redis": "^6.1.1",
    "uuid": "^3.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.13",
    "@types/ioredis": "^4.28.1",
    "bcrypt": "^5.0.1",
    "chalk": "^3.0.0",
    "cli-progress": "^3.10.0",
    "json-fn": "^1.1.1",
    "lodash": "^4.17.20",
    "nodemon": "^2.0.16",
    "object-scan": "^18.0.0",
    "pino": "^7.9.1",
    "ramda": "^0.27.2",
    "randomstring": "^1.1.5",
    "socket.io-client": "^2.4.0",
    "ts-node": "^10.4.0",
    "typescript": "^4.5.2",
    "yargs": "^15.1.0"
  },
  "engines": {
    "node": ">=14"
  }
}
